DATABASE_URL="postgresql://user:password@host:5432/ezipay?sslmode=require"

# Signed session cookies (HMAC). Min 32 characters.
# Generate: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Public URL of this app (Netlify / local) — used for Stitch redirect_uri
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="EZIPAY"

# Demo mode mocks Stitch / Smile only (not Twilio).
# When TWILIO_* are set, login OTP and payment PINs are real SMS.
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"

# --- Live integrations (set DEMO_MODE=false and NEXT_PUBLIC_DEMO_MODE=false) ---

# Stitch Pay By Bank / PayShap — https://docs.stitch.money
STITCH_CLIENT_ID=""
STITCH_CLIENT_SECRET=""
STITCH_WEBHOOK_SECRET=""
# Point Stitch webhook to: {NEXT_PUBLIC_APP_URL}/api/webhook/stitch

# Smile Identity Enhanced KYC — https://docs.usesmileid.com
SMILE_PARTNER_ID=""
SMILE_API_KEY=""
# 0 = sandbox (testapi), 1 = production (api)
SMILE_SID_SERVER="0"

# Twilio SMS — login OTP + customer payment PIN
# If all three are set, real SMS is sent (even when DEMO_MODE=true).
# Twilio trial: verify each destination number in the Twilio console first.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Optional: pooled connection string on Netlify/serverless
# DATABASE_URL="postgresql://...@...-pooler.../ezipay?pgbouncer=true"

# Claim any free Prisma Postgres instance in the Prisma console before it expires.
