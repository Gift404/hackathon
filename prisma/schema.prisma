// CashTrail lessons applied: money is integer cents — never Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  PAYSHAP_QR
  PAYSHAP_PHONE
  EFT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model Trader {
  id                  String   @id @default(cuid())
  phone               String   @unique
  idNumber            String   @unique
  fullName            String
  businessName        String?
  tier                Int      @default(1)
  dailyLimitCents     Int      @default(500000) // R5,000
  totalVerifiedCents  Int      @default(0)
  livenessVerified    Boolean  @default(false)
  idVerified          Boolean  @default(false)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  transactions Transaction[]
  paymentLinks PaymentLink[]
}

model Transaction {
  id            String            @id @default(cuid())
  traderId      String
  trader        Trader            @relation(fields: [traderId], references: [id])
  amountCents   Int
  currency      String            @default("ZAR")
  customerPhone String?
  customerName  String?
  method        PaymentMethod
  status        TransactionStatus @default(PENDING)
  reference     String            @unique
  stitchRef     String?
  /// Hashed SMS PIN the customer receives for phone-pay confirmation (no gateway).
  approvalPinHash      String?
  approvalPinExpiresAt DateTime?
  createdAt     DateTime          @default(now())
  settledAt     DateTime?

  @@index([traderId, createdAt])
  @@index([stitchRef])
}

model PaymentLink {
  id          String   @id @default(cuid())
  traderId    String
  trader      Trader   @relation(fields: [traderId], references: [id])
  amountCents Int?
  reference   String?  @unique
  qrData      String
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([traderId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, codeHash])
}
